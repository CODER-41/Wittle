# Used by docker-compose.yml itself (Postgres container + inter-service wiring).
# Copy this file to ".env" (same folder as docker-compose.yml) and adjust as needed.
# This is SEPARATE from backend/.env, which holds your Flask app secrets.

POSTGRES_USER=wittle_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=wittle_db

# The origin your React app is served from - used for Flask-CORS.
# In this setup, everything goes through wittle-nginx on port 80,
# so the browser sees a single origin: http://localhost
ALLOWED_ORIGINS=http://localhost
